import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import QtQuick.Window
import "Theme.js" as Theme

ApplicationWindow {
    id: win
    width: 1320; height: 820
    minimumWidth: nexa.compact ? 200 : 600
    minimumHeight: nexa.compact ? 200 : 640
    visible: true
    title: "NEXA — by NXS MEDIA"
    color: "#040914"
    flags: nexa.compact ? (Qt.Window | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool) : Qt.Window

    readonly property color cyan: "#22d3ee"
    readonly property color blue: "#3b82f6"
    readonly property color purple: "#a855f7"
    readonly property color panel: "#0a1428"
    readonly property color panelBorder: "#16325a"
    readonly property color textDim: "#8fb3d1"
    property var savedGeometry: null
    // Trình xem 3D mở SONG SONG với giao diện NEXA (cột phải), không che NEXA.
    readonly property bool viewer3dOpen: nexa3d.viewerOpen
    // Sinh code cũng mở SONG SONG (cột phải) như trình xem 3D; đang mở code thì trình xem 3D nhường chỗ.
    readonly property bool codeShown: nexaCode.panelOpen && !nexa.compact
    readonly property bool viewerShown: viewer3dOpen && !nexa.compact && !codeShown
    readonly property bool sideShown: viewerShown || codeShown
    // cột NEXA khi có bảng bên phải: đủ cho quả cầu + hội thoại, phần còn lại cho bảng (≥ bề ngang iPad mini khi đủ chỗ)
    readonly property real sideNexaWidth: Math.max(360, Math.min(520, win.width * 0.32))
    // Cửa sổ hẹp (NEXA xếp cạnh ứng dụng vừa mở — nexa/desktop/side_by_side.py): quả cầu trên, hội thoại dưới.
    readonly property bool narrow: !nexa.compact && width < 1000
    readonly property bool stacked: sideShown || narrow
    property bool autoMaximized: false
    function makeRoom() {
        if (nexa.compact) win.enterCompact(false)
        if (win.visibility === Window.Minimized || !win.visible) win.showNormal()
        if (win.visibility === Window.Windowed && win.width < 1500) { autoMaximized = true; win.showMaximized() }
        win.raise()
    }
    onSideShownChanged: {
        if (sideShown) makeRoom()
        else if (autoMaximized) {
            autoMaximized = false
            if (win.visibility === Window.Maximized) win.showNormal()
        }
    }
    onViewer3dOpenChanged: if (viewer3dOpen && nexa.compact) win.enterCompact(false)

    Connections {
        target: nexa3d
        function onToast(text, isError) { toastBox.show(text, isError) }
    }
    Connections {
        target: nexaCode
        function onToast(text, isError) { toastBox.show(text, isError) }
        function onPanelChanged() {
            if (nexaCode.panelOpen) {
                if (nexa.compact) win.enterCompact(false)
                if (win.visibility === Window.Minimized || !win.visible) win.showNormal()
            }
        }
    }
    Connections {
        target: nexa
        function onToast(text, isError) { toastBox.show(text, isError) }
        // Vỗ tay đánh thức sau lúc vắng: đưa NEXA lên trước để chào anh.
        function onRaiseWindow() {
            if (win.visibility === Window.Minimized || !win.visible) win.showNormal()
            win.raise()
            win.requestActivate()
        }
    }
    Component.onCompleted: {
        if (nexa.smokeOpen === "settings") settingsPopup.open()
        else if (nexa.smokeOpen === "gestures") gesturePanel.visible = true
        else if (nexa.smokeOpen === "3d") nexa3d.workspace = true
        else if (nexa.smokeOpen === "code") nexaCode.openPanel()
    }

    function enterCompact(on) {
        if (on) {
            savedGeometry = { x: win.x, y: win.y, w: win.width, h: win.height }
            nexa.compact = true
            win.width = 230; win.height = 230
            win.x = Screen.desktopAvailableWidth - 250 + Screen.virtualX
            win.y = Screen.desktopAvailableHeight - 260 + Screen.virtualY
        } else {
            nexa.compact = false
            if (savedGeometry) { win.x = savedGeometry.x; win.y = savedGeometry.y; win.width = savedGeometry.w; win.height = savedGeometry.h }
        }
    }

    // ---------- thành phần tái sử dụng ----------
    // Icon: Segoe Fluent Icons (Windows 11), dự phòng Segoe MDL2 Assets (Windows 10) — cùng mã glyph.
    readonly property string iconFont: Qt.fontFamilies().indexOf("Segoe Fluent Icons") >= 0 ? "Segoe Fluent Icons" : "Segoe MDL2 Assets"
    function glyph(code) { return String.fromCharCode(code) }
    // Màu chủ đạo theo trạng thái (Theme.js) — trùng màu quả cầu: nghe cyan · suy nghĩ tím · nói vàng cam…
    property color stateAccent: Theme.stateColor(nexa.state)
    Behavior on stateAccent { ColorAnimation { duration: 450 } }
    readonly property bool busy: nexa.state === "THINKING" || nexa.state === "EXECUTING" || nexa.state === "CONFIRMING"
    readonly property string lastUserText: {
        var tl = nexa.timeline
        for (var i = tl.length - 1; i >= 0; i--)
            if (tl[i].kind !== "task" && tl[i].role === "user") return tl[i].text || ""
        return ""
    }
    readonly property string lastAssistantText: {
        var tl = nexa.timeline
        for (var i = tl.length - 1; i >= 0; i--)
            if (tl[i].kind !== "task" && tl[i].role === "assistant") return tl[i].text || ""
        return ""
    }
    // bước đang chạy gần nhất (hiện thành một dòng nhỏ dưới quả cầu)
    readonly property var liveTask: {
        var tl = nexa.timeline
        for (var i = tl.length - 1; i >= 0; i--)
            if (tl[i].kind === "task")
                return (tl[i].status === "running" || tl[i].status === "queued" || tl[i].status === "confirming") ? tl[i] : null
        return null
    }
    // ngăn kéo hội thoại ở mép phải (đóng mặc định: màn hình chính chỉ có quả cầu + phụ đề)
    property bool historyOpen: false
    function toggleHistory() {
        historyOpen = !historyOpen
        if (historyOpen) Qt.callLater(function() { input.forceActiveFocus() })
    }
    Shortcut { sequence: "Ctrl+H"; enabled: !nexa.compact; onActivated: win.toggleHistory() }
    Shortcut { sequence: "Esc"; enabled: win.historyOpen && !nexa.compact; onActivated: win.historyOpen = false }
    function taskColor(st) {
        return st === "done" ? "#34d399" : (st === "running" || st === "queued") ? win.cyan
             : st === "confirming" ? "#fbbf24" : st === "auto_approved" ? "#a855f7" : st === "cancelled" ? "#64748b" : "#fb7185"
    }
    function taskGlyph(st) {
        return st === "done" ? 0xE73E : st === "confirming" ? 0xE7BA : st === "auto_approved" ? 0xE785 : 0xE711
    }

    component NButton: Button {
        id: nb
        property color tint: win.cyan
        property bool danger: false
        font.pixelSize: 13
        leftPadding: 14; rightPadding: 14; topPadding: 7; bottomPadding: 7
        contentItem: Text { text: nb.text; font: nb.font; color: nb.enabled ? "white" : "#5b7089"
                            horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter; elide: Text.ElideRight }
        background: Rectangle {
            radius: 8
            color: nb.danger ? (nb.down ? "#9f1239" : "#be123c") : (nb.down ? Qt.darker(nb.tint, 2.2) : (nb.hovered ? "#12305a" : "#0d2142"))
            border.color: nb.danger ? "#fb7185" : Qt.rgba(nb.tint.r, nb.tint.g, nb.tint.b, nb.hovered ? 0.9 : 0.45)
            border.width: 1
        }
    }
    component NTip: ToolTip {
        id: tip
        delay: 300
        contentItem: Text { text: tip.text; color: "white"; font.pixelSize: 12 }
        background: Rectangle { radius: 6; color: "#0b1a33"; border.color: win.panelBorder }
    }
    component Chip: Rectangle {
        id: chip
        property string label: ""
        property string value: ""
        property int level: 0     // 0 tắt, 1 tốt, 2 cảnh báo, 3 lỗi
        // implicit* (không phải width/height): RowLayout của thanh tiêu đề xếp theo implicit size
        radius: 16; implicitHeight: 32
        implicitWidth: chipRow.implicitWidth + 20
        color: "#0b1a33"
        border.color: level === 1 ? "#1f9d8b" : level === 2 ? "#b7791f" : level === 3 ? "#be123c" : "#1e3352"
        Row {
            id: chipRow; anchors.centerIn: parent; spacing: 6
            Rectangle { width: 8; height: 8; radius: 4; anchors.verticalCenter: parent.verticalCenter
                        color: chip.level === 1 ? "#34d399" : chip.level === 2 ? "#fbbf24" : chip.level === 3 ? "#fb7185" : "#475569" }
            Text { text: chip.label; color: win.textDim; font.pixelSize: 12 }
            Text { text: chip.value; color: "white"; font.pixelSize: 12; font.bold: true; elide: Text.ElideRight
                   width: Math.min(implicitWidth, win.narrow ? 90 : 150) }
        }
    }
    // Icon trạng thái tròn ở thanh tiêu đề: màu = mức (tốt / cảnh báo / lỗi), rê chuột xem chi tiết.
    component StatusIcon: Rectangle {
        id: si
        property int glyphCode: 0
        property string label: ""
        property string value: ""
        property int level: 0     // 0 tắt, 1 tốt, 2 cảnh báo, 3 lỗi
        signal clicked()
        readonly property color levelColor: level === 1 ? "#34d399" : level === 2 ? "#fbbf24" : level === 3 ? "#fb7185" : "#475569"
        width: 32; height: 32; radius: 16
        color: siMouse.containsMouse ? "#12264a" : Qt.rgba(levelColor.r, levelColor.g, levelColor.b, level === 0 ? 0 : 0.08)
        border.width: 1
        border.color: Qt.rgba(levelColor.r, levelColor.g, levelColor.b, level === 0 ? 0.25 : 0.55)
        Text { anchors.centerIn: parent; text: win.glyph(si.glyphCode); font.family: win.iconFont; font.pixelSize: 15
               color: si.level === 0 ? "#5b7089" : si.level === 1 ? "#cfe9ff" : si.levelColor }
        Rectangle { visible: si.level >= 2; width: 10; height: 10; radius: 5; color: si.levelColor
                    border.color: "#040914"; border.width: 2
                    anchors.right: parent.right; anchors.top: parent.top; anchors.rightMargin: -2; anchors.topMargin: -2 }
        MouseArea { id: siMouse; anchors.fill: parent; hoverEnabled: true; onClicked: si.clicked() }
        NTip { visible: siMouse.containsMouse; text: si.label + ": " + si.value }
    }
    component HeaderButton: Rectangle {
        id: hb
        property int glyphCode: 0
        property string tip: ""
        property color hoverTint: win.cyan
        signal clicked()
        width: 34; height: 34; radius: 10
        color: hbMouse.pressed ? "#0a1a36" : hbMouse.containsMouse ? "#12264a" : "transparent"
        border.width: 1
        border.color: hbMouse.containsMouse ? Qt.rgba(hoverTint.r, hoverTint.g, hoverTint.b, 0.7) : "#1e3352"
        Text { anchors.centerIn: parent; text: win.glyph(hb.glyphCode); font.family: win.iconFont; font.pixelSize: 15
               color: hbMouse.containsMouse ? hb.hoverTint : "#a9c3dc" }
        MouseArea { id: hbMouse; anchors.fill: parent; hoverEnabled: true; onClicked: hb.clicked() }
        NTip { visible: hbMouse.containsMouse; text: hb.tip }
    }
    // Nút tròn trên dock: icon + chú thích nhỏ; primary = nền màu trạng thái; active = đang bật.
    component DockButton: Item {
        id: db
        property int glyphCode: 0
        property string caption: ""
        property string tip: caption
        property color tint: win.cyan
        property bool active: false
        property bool primary: false
        property bool pulsing: false
        property bool showCaption: true
        property real size: 42
        signal clicked()
        opacity: enabled ? 1 : 0.4
        implicitWidth: Math.max(size, showCaption ? capText.implicitWidth : 0) + 8
        implicitHeight: size + (showCaption ? capText.implicitHeight + 3 : 0)
        width: implicitWidth; height: implicitHeight
        Rectangle {   // vòng lan tỏa khi đang nghe
            anchors.centerIn: disc
            width: db.size; height: db.size; radius: db.size / 2
            color: "transparent"; border.color: db.tint; border.width: 2
            visible: db.pulsing
            NumberAnimation on scale { running: db.pulsing; loops: Animation.Infinite; from: 1; to: 1.45; duration: 1100; easing.type: Easing.OutCubic }
            NumberAnimation on opacity { running: db.pulsing; loops: Animation.Infinite; from: 0.8; to: 0; duration: 1100; easing.type: Easing.OutCubic }
        }
        Rectangle {
            id: disc
            width: db.size; height: db.size; radius: db.size / 2
            anchors.horizontalCenter: parent.horizontalCenter
            color: db.primary ? Qt.rgba(db.tint.r, db.tint.g, db.tint.b, dbMouse.pressed ? 0.55 : dbMouse.containsMouse ? 0.42 : 0.3)
                 : db.active ? Qt.rgba(db.tint.r, db.tint.g, db.tint.b, 0.28)
                 : dbMouse.pressed ? "#0a1a36" : dbMouse.containsMouse ? "#14305a" : "#0d2142"
            border.width: db.primary || db.active ? 1.5 : 1
            border.color: Qt.rgba(db.tint.r, db.tint.g, db.tint.b, db.primary || db.active || dbMouse.containsMouse ? 0.95 : 0.4)
            scale: dbMouse.pressed ? 0.94 : 1
            Behavior on scale { NumberAnimation { duration: 90 } }
            Text { anchors.centerIn: parent; text: win.glyph(db.glyphCode); font.family: win.iconFont
                   font.pixelSize: Math.round(db.size * 0.42); color: db.primary || db.active ? "white" : "#cfe9ff" }
        }
        Text { id: capText; visible: db.showCaption; anchors.top: disc.bottom; anchors.topMargin: 3
               anchors.horizontalCenter: parent.horizontalCenter; text: db.caption; font.pixelSize: 11
               color: db.active || db.primary ? "white" : win.textDim }
        MouseArea { id: dbMouse; anchors.fill: parent; hoverEnabled: true; enabled: db.enabled; onClicked: db.clicked() }
        NTip { visible: dbMouse.containsMouse && db.tip.length > 0; text: db.tip }
    }
    // Vạch đo mảnh ở góc sân khấu: nhãn · giá trị, 12 đoạn tô theo mức tải
    component Meter: Item {
        id: mt
        property string label: ""
        property real v: -1                 // 0..1; âm = không có số liệu
        property string valueText: "—"
        implicitWidth: 132; implicitHeight: 30
        readonly property int segs: 12
        readonly property color col: v < 0 ? "#334155" : Theme.loadColor(v)
        property real shownV: v
        Behavior on shownV { NumberAnimation { duration: 700; easing.type: Easing.OutCubic } }
        Text { anchors.left: parent.left; anchors.top: parent.top; text: mt.label; color: "#6f8fb0"
               font.pixelSize: 11; font.bold: true; font.letterSpacing: 2 }
        Text { anchors.right: parent.right; anchors.top: parent.top; text: mt.valueText; color: "#dbeafe"; font.pixelSize: 12 }
        Row {
            anchors.left: parent.left; anchors.bottom: parent.bottom
            spacing: 3
            Repeater {
                model: mt.segs
                Rectangle {
                    required property int index
                    width: (mt.width - (mt.segs - 1) * 3) / mt.segs; height: 5; radius: 1
                    color: index < Math.round(Math.max(0, mt.shownV) * mt.segs) ? mt.col : "#132540"
                }
            }
        }
    }

    component DarkMenuItem: MenuItem {
        id: dmi
        implicitWidth: 230
        contentItem: Text { text: dmi.text; color: dmi.enabled ? "white" : "#5b7089"; font.pixelSize: 13
                            leftPadding: 6; verticalAlignment: Text.AlignVCenter }
        background: Rectangle { radius: 6; color: dmi.highlighted ? "#14305a" : "transparent" }
    }

    // ---------- nền ----------
    Rectangle {
        anchors.fill: parent
        gradient: Gradient {
            GradientStop { position: 0.0; color: "#050c1c" }
            GradientStop { position: 0.55; color: "#040914" }
            GradientStop { position: 1.0; color: "#070417" }
        }
        visible: !nexa.compact
    }

    // ---------- chế độ thu gọn ----------
    Item {
        anchors.fill: parent
        visible: nexa.compact
        Orb { anchors.fill: parent; appState: nexa.state; micLevel: nexa.micLevel; outLevel: nexa.outLevel; outBands: nexa.outBands
              effects: nexa.effects === "full" ? "reduced" : nexa.effects }
        MouseArea {
            anchors.fill: parent
            property point press
            onPressed: (m) => press = Qt.point(m.x, m.y)
            onPositionChanged: (m) => { if (pressed) { win.x += m.x - press.x; win.y += m.y - press.y } }
            onDoubleClicked: win.enterCompact(false)
        }
        Text { anchors.bottom: parent.bottom; anchors.horizontalCenter: parent.horizontalCenter; anchors.bottomMargin: 6
               text: nexa.stateLabel; color: "white"; font.pixelSize: 11; style: Text.Outline; styleColor: "#040914" }
        Rectangle {
            anchors.top: parent.top; anchors.right: parent.right; anchors.margins: 6
            width: 26; height: 26; radius: 13; color: "#be123c"
            Text { anchors.centerIn: parent; text: "■"; color: "white"; font.pixelSize: 12 }
            MouseArea { anchors.fill: parent; onClicked: nexa.stop() }
        }
    }

    // ---------- giao diện đầy đủ ----------
    ColumnLayout {
        anchors.fill: parent
        anchors.margins: 14
        spacing: 10
        visible: !nexa.compact

        // Thanh tiêu đề: logo · icon trạng thái · Cài đặt / Thu gọn / Thoát
        RowLayout {
            Layout.fillWidth: true
            spacing: 8
            Column {
                spacing: 0
                Row {
                    spacing: 8
                    Text { text: "NEXA"; color: win.cyan; font.pixelSize: 26; font.bold: true; font.letterSpacing: 6 }
                    Text { visible: !win.narrow; text: "by NXS MEDIA"; color: "#7c8db5"; font.pixelSize: 12
                           font.letterSpacing: 1; anchors.bottom: parent.bottom; anchors.bottomMargin: 5 }
                }
                Text { text: "Trợ lý của anh Nguyễn Xuân Sơn"; color: win.textDim; font.pixelSize: 12 }
            }
            Item { Layout.fillWidth: true }
            // tiến độ việc dài (chỉ hiện khi đang chạy)
            Chip { visible: nexa3d.activeJob.id !== undefined && nexa3d.activeJob.terminal === false; label: "3D"
                   value: (nexa3d.activeJob.label || "") + " " + Math.round((nexa3d.activeJob.progress || 0) * 100) + "%"; level: 2
                   MouseArea { anchors.fill: parent; onClicked: nexa3d.workspace = true } }
            Chip { visible: nexaCode.busy; label: "Code"
                   value: (nexaCode.job.message || "") + " " + Math.round((nexaCode.job.progress || 0) * 100) + "%"; level: 2
                   MouseArea { anchors.fill: parent; onClicked: nexaCode.openPanel() } }
            Rectangle {   // viên nang chứa icon trạng thái
                implicitWidth: statusRow.implicitWidth + 12; implicitHeight: 42; radius: 21
                color: "#0a1428"; border.color: win.panelBorder
            Row {
                id: statusRow
                objectName: "statusIcons"
                anchors.centerIn: parent
                spacing: 4
                StatusIcon { visible: nexa.visionSending; glyphCode: 0xE7B3; label: "Đang gửi ảnh"; value: "Gemini"; level: 2 }
                StatusIcon { glyphCode: 0xE720; label: "Mic"; value: (nexa.status.mic && nexa.status.mic.ok) ? "bật" : "lỗi"
                             level: (nexa.status.mic && nexa.status.mic.ok) ? 1 : 3 }
                StatusIcon { glyphCode: 0xE722; label: "Camera"; value: nexa.cameraOn ? "ĐANG DÙNG" : "tắt"; level: nexa.cameraOn ? 2 : 0
                             onClicked: gesturePanel.visible = !gesturePanel.visible }
                StatusIcon { glyphCode: 0xE99A; label: "AI"; value: (nexa.status.ai && nexa.status.ai.ok) ? "Gemini" : "Cơ bản"
                             level: (nexa.status.ai && nexa.status.ai.ok) ? 1 : 2 }
                StatusIcon { glyphCode: 0xE8C1; label: "Nhận dạng giọng (STT)"
                             value: (nexa.status.stt && nexa.status.stt.ready) ? nexa.status.stt.model : ((nexa.status.stt && nexa.status.stt.loading) ? "đang nạp" : "chưa sẵn sàng")
                             level: (nexa.status.stt && nexa.status.stt.ready) ? 1 : 2 }
                StatusIcon { glyphCode: 0xE767; label: "Giọng nói"
                             value: (nexa.status.tts && nexa.status.tts.backend) ? nexa.status.tts.backend : ((nexa.status.tts && nexa.status.tts.chain && nexa.status.tts.chain.length) ? "chờ" : "chữ")
                             level: (nexa.status.tts && nexa.status.tts.backend) ? 1 : 0 }
                StatusIcon { glyphCode: 0xE71B; label: "Bridge trình duyệt"
                             value: (nexa.status.bridge && nexa.status.bridge.connected) ? nexa.status.bridge.browsers.join(", ") : "chưa nối"
                             level: (nexa.status.bridge && nexa.status.bridge.connected) ? 1 : 0 }
                StatusIcon { glyphCode: nexa.status.autonomy === "full" ? 0xE785 : 0xE72E; label: "Quyền"
                             value: nexa.status.autonomy === "full" ? "TOÀN QUYỀN" : "tiêu chuẩn"
                             level: nexa.status.autonomy === "full" ? 2 : 1 }
            }
            }
            Rectangle { implicitWidth: 1; implicitHeight: 24; color: win.panelBorder; Layout.leftMargin: 4; Layout.rightMargin: 4 }
            HeaderButton { glyphCode: 0xE713; tip: "Cài đặt"; onClicked: settingsPopup.open() }
            HeaderButton { glyphCode: 0xE73F; tip: "Thu gọn thành quả cầu nổi (nhấp đúp để mở lại)"; onClicked: win.enterCompact(true) }
            HeaderButton { glyphCode: 0xE7E8; tip: "Thoát NEXA"; hoverTint: "#fb7185"; onClicked: nexa.quit() }
        }

        // Nội dung chính
        RowLayout {
            Layout.fillWidth: true
            Layout.fillHeight: true
            spacing: 14

            // Sân khấu JARVIS: quả cầu lớn ở giữa, phụ đề ngay dưới quả cầu rồi mờ dần,
            // thông số máy là các vạch mảnh ở hai góc trên, hội thoại nằm trong ngăn kéo cạnh phải.
            Item {
                id: stage
                objectName: "stage"
                Layout.fillWidth: !win.codeShown
                Layout.preferredWidth: win.codeShown ? win.sideNexaWidth : -1
                Layout.maximumWidth: win.codeShown ? win.sideNexaWidth : Number.POSITIVE_INFINITY
                Layout.fillHeight: true
                clip: false
                readonly property bool tight: width < 560
                // ngăn kéo mở trên màn rộng: nội dung dịch sang trái nhường chỗ, không bị che
                readonly property bool drawerDocked: win.historyOpen && width >= 900
                readonly property real drawerW: Math.min(width - 24, 400)

                // khung góc HUD mảnh
                Repeater {
                    model: 4
                    Item {
                        required property int index
                        width: 22; height: 22
                        x: (index === 1 || index === 2) ? stage.width - width : 0
                        y: index >= 2 ? stage.height - height : 0
                        rotation: index * 90
                        opacity: 0.45
                        Rectangle { width: parent.width; height: 2; radius: 1; color: win.stateAccent }
                        Rectangle { width: 2; height: parent.height; radius: 1; color: win.stateAccent }
                    }
                }

                Item {
                    id: stageBody
                    anchors.fill: parent
                    anchors.rightMargin: stage.drawerDocked ? stage.drawerW + 16 : 0
                    Behavior on anchors.rightMargin { NumberAnimation { duration: 320; easing.type: Easing.OutCubic } }

                    // Thông số máy: vạch mảnh ở hai góc trên (CPU · GPU | RAM · AI)
                    Item {
                        id: statsStrip
                        objectName: "statsRing"
                        anchors.left: parent.left; anchors.right: parent.right; anchors.top: parent.top
                        anchors.leftMargin: 30; anchors.rightMargin: 30; anchors.topMargin: 12
                        height: 34
                        visible: nexa.sysStats.cpu !== undefined
                        readonly property var st: nexa.sysStats
                        function pct(v) { return v === null || v === undefined ? "—" : Math.round(v) + "%" }
                        function ms(v) { return !v ? "—" : v < 1000 ? Math.round(v) + " ms" : (v / 1000).toFixed(1) + " s" }
                        readonly property bool hasGpu: st.gpu !== null && st.gpu !== undefined
                        Row {
                            anchors.left: parent.left
                            spacing: 22
                            Meter { label: "CPU"; v: (statsStrip.st.cpu || 0) / 100; valueText: statsStrip.pct(statsStrip.st.cpu) }
                            Meter { visible: !stage.tight; label: "GPU"; v: statsStrip.hasGpu ? statsStrip.st.gpu / 100 : -1
                                    valueText: statsStrip.pct(statsStrip.st.gpu) }
                        }
                        Row {
                            anchors.right: parent.right
                            spacing: 22
                            Meter { visible: !stage.tight; label: "AI"; v: Math.min(1, (statsStrip.st.ai_ms || 0) / 5000)
                                    valueText: statsStrip.ms(statsStrip.st.ai_ms) }
                            Meter { label: "RAM"; v: (statsStrip.st.ram || 0) / 100; valueText: statsStrip.pct(statsStrip.st.ram) }
                        }
                    }

                    ColumnLayout {
                        anchors.fill: parent
                        anchors.topMargin: statsStrip.visible ? 50 : 16
                        anchors.bottomMargin: 6
                        spacing: 8

                        Item {
                            id: orbArea
                            objectName: "orbArea"
                            Layout.fillWidth: true; Layout.fillHeight: true
                            readonly property real orbSize: Math.min(width * 0.86, height, 600)
                            // quầng sáng lớn theo màu trạng thái sau quả cầu
                            Canvas {
                                id: orbGlow
                                anchors.centerIn: parent
                                width: orbArea.orbSize * 1.7; height: width
                                visible: width > 0
                                property color ac: win.stateAccent
                                onAcChanged: requestPaint()
                                onWidthChanged: requestPaint()
                                renderStrategy: Canvas.Cooperative
                                onPaint: {
                                    var ctx = getContext("2d"); ctx.reset()
                                    var r = width / 2, g = ctx.createRadialGradient(r, r, 0, r, r, r)
                                    g.addColorStop(0.0, Qt.rgba(ac.r, ac.g, ac.b, 0.20))
                                    g.addColorStop(0.35, Qt.rgba(ac.r, ac.g, ac.b, 0.08))
                                    g.addColorStop(1.0, Qt.rgba(ac.r, ac.g, ac.b, 0.0))
                                    ctx.fillStyle = g; ctx.fillRect(0, 0, width, height)
                                }
                            }
                            Orb {
                                id: mainOrb
                                anchors.centerIn: parent
                                width: orbArea.orbSize; height: width
                                appState: nexa.state; micLevel: nexa.micLevel; outLevel: nexa.outLevel; outBands: nexa.outBands; effects: nexa.effects
                            }
                            MouseArea { anchors.fill: mainOrb; onDoubleClicked: nexa.wake() }
                            Text {
                                visible: nexa.showFps
                                anchors.left: parent.left; anchors.top: parent.top; anchors.leftMargin: 30
                                text: "FPS " + mainOrb.measuredFps.toFixed(0); color: "#34506e"; font.pixelSize: 10
                            }
                        }

                        // Trạng thái: chữ thưa, chấm nhấp nháy khi đang hoạt động
                        Rectangle {
                            id: statePill
                            objectName: "statePill"
                            Layout.alignment: Qt.AlignHCenter
                            readonly property real maxW: stageBody.width - 40
                            Layout.preferredWidth: Math.min(maxW, pillRow.implicitWidth + 30)
                            Layout.preferredHeight: 30
                            radius: 15
                            color: Qt.rgba(win.stateAccent.r, win.stateAccent.g, win.stateAccent.b, 0.08)
                            border.color: Qt.rgba(win.stateAccent.r, win.stateAccent.g, win.stateAccent.b, 0.45)
                            Row {
                                id: pillRow
                                anchors.centerIn: parent
                                spacing: 8
                                Rectangle {
                                    id: stateDot
                                    width: 8; height: 8; radius: 4; anchors.verticalCenter: parent.verticalCenter
                                    color: win.stateAccent
                                    readonly property bool live: nexa.state !== "STANDBY" && nexa.state !== "INITIALIZING"
                                    onLiveChanged: if (!live) opacity = 1
                                    SequentialAnimation on opacity {
                                        running: stateDot.live; loops: Animation.Infinite
                                        NumberAnimation { to: 0.25; duration: 600; easing.type: Easing.InOutSine }
                                        NumberAnimation { to: 1; duration: 600; easing.type: Easing.InOutSine }
                                    }
                                }
                                Text { id: pillLabel; objectName: "stateLabel"; text: nexa.stateLabel.toUpperCase(); color: win.stateAccent
                                       font.pixelSize: 13; font.bold: true; font.letterSpacing: 3 }
                                Text {
                                    visible: nexa.stateDetail.length > 0 && nexa.state !== "STANDBY"
                                    width: Math.min(implicitWidth, Math.max(0, statePill.maxW - 30 - 16 - pillLabel.implicitWidth - 8))
                                    text: nexa.stateDetail; color: win.textDim; font.pixelSize: 12; elide: Text.ElideRight
                                    anchors.verticalCenter: parent.verticalCenter
                                }
                            }
                        }

                        // Phụ đề: câu anh vừa nói (nghiêng, mờ) và câu NEXA trả lời (gõ dần), tự mờ sau ít giây
                        Item {
                            id: subs
                            objectName: "subtitles"
                            Layout.fillWidth: true
                            Layout.preferredHeight: Math.max(78, subCol.implicitHeight)
                            property bool fresh: true
                            readonly property bool holding: nexa.listeningSpeech || win.busy || nexa.state === "SPEAKING"
                            readonly property string userLine: nexa.listeningSpeech
                                ? (nexa.heardText.length > 0 ? nexa.heardText : "Em đang nghe…") : win.lastUserText
                            function refresh() { fresh = true; fadeTimer.restart() }
                            onUserLineChanged: refresh()
                            onHoldingChanged: if (!holding) fadeTimer.restart()
                            Timer { id: fadeTimer; interval: 14000; running: true; onTriggered: if (!subs.holding) subs.fresh = false }
                            opacity: (fresh || holding) ? 1 : 0.0
                            Behavior on opacity { NumberAnimation { duration: 1400; easing.type: Easing.InOutQuad } }
                            Column {
                                id: subCol
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: Math.min(parent.width - 40, 820)
                                spacing: 6
                                // việc đang chạy: một dòng nhỏ, không phải thẻ
                                Row {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    visible: win.liveTask !== null
                                    spacing: 8
                                    Text { text: win.glyph(0xE9F5); font.family: win.iconFont; font.pixelSize: 13; color: win.stateAccent
                                           anchors.verticalCenter: parent.verticalCenter
                                           RotationAnimator on rotation { from: 0; to: 360; duration: 1600; loops: Animation.Infinite
                                                                          running: win.liveTask !== null } }
                                    Text { text: win.liveTask ? (win.liveTask.title || "") + (win.liveTask.text ? " · " + win.liveTask.text : "") : ""
                                           color: win.textDim; font.pixelSize: 13; elide: Text.ElideRight
                                           width: Math.min(implicitWidth, subCol.width - 30) }
                                }
                                Text {
                                    id: userSub
                                    width: parent.width
                                    visible: text.length > 0
                                    text: subs.userLine.length > 0 ? "“" + subs.userLine + "”" : ""
                                    color: nexa.listeningSpeech ? "#a5f3fc" : "#8fb3d1"
                                    font.pixelSize: 16; font.italic: true
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.Wrap; maximumLineCount: 2; elide: Text.ElideRight; textFormat: Text.PlainText
                                }
                                Text {
                                    id: replySub
                                    width: parent.width
                                    property string full: win.lastAssistantText
                                    property int shown: full.length
                                    onFullChanged: {
                                        typer.stop(); shown = 0
                                        typer.to = full.length; typer.duration = Math.min(2200, full.length * 22)
                                        typer.start(); subs.refresh()
                                    }
                                    NumberAnimation { id: typer; target: replySub; property: "shown"; from: 0 }
                                    visible: full.length > 0
                                    text: full.substring(0, shown)
                                    color: "#f1f6ff"; font.pixelSize: stage.tight ? 17 : 21; lineHeight: 1.1
                                    style: Text.Raised; styleColor: "#040914"
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.Wrap; maximumLineCount: 3; elide: Text.ElideRight; textFormat: Text.PlainText
                                }
                                Text {
                                    width: parent.width
                                    visible: nexa.timeline.length === 0 && !nexa.listeningSpeech
                                    text: "Vỗ tay, nói “Nexa ơi” hoặc bấm Nói"
                                    color: "#56759a"; font.pixelSize: 15; font.letterSpacing: 1
                                    horizontalAlignment: Text.AlignHCenter
                                }
                            }
                        }

                        // Điều khiển tạm khóa sau lệnh dừng
                        Rectangle {
                            visible: nexa.controlPaused
                            Layout.alignment: Qt.AlignHCenter
                            Layout.preferredWidth: Math.min(stageBody.width - 20, pausedRow.implicitWidth + 24)
                            Layout.preferredHeight: pausedRow.implicitHeight + 12
                            radius: 12; color: "#1f1a0a"; border.color: "#b7791f"
                            RowLayout {
                                id: pausedRow; anchors.centerIn: parent; spacing: 10
                                Text { text: "Điều khiển đang tạm khóa sau lệnh dừng."; color: "#fbbf24"; font.pixelSize: 13 }
                                NButton { text: "▶ Tiếp tục"; tint: "#34d399"; font.pixelSize: 12; onClicked: nexa.resumeControl() }
                            }
                        }

                        // Dock tròn + nút DỪNG KHẨN CẤP
                        RowLayout {
                            Layout.alignment: Qt.AlignHCenter
                            Layout.bottomMargin: 8
                            spacing: stage.tight ? 8 : 14
                            Rectangle {
                                id: dock
                                objectName: "dock"
                                implicitWidth: dockRow.implicitWidth + (stage.tight ? 14 : 22)
                                implicitHeight: dockRow.implicitHeight + 14
                                radius: stage.tight ? height / 2 : 26
                                color: "#cc081226"
                                border.color: Qt.rgba(win.stateAccent.r, win.stateAccent.g, win.stateAccent.b, 0.3)
                                Row {
                                    id: dockRow
                                    anchors.centerIn: parent
                                    spacing: stage.tight ? 0 : 4
                                    DockButton {
                                        primary: true; tint: win.stateAccent; showCaption: !stage.tight
                                        size: stage.tight ? 40 : 46
                                        glyphCode: 0xE720
                                        pulsing: nexa.state === "LISTENING"
                                        caption: nexa.state === "STANDBY" ? "Đánh thức" : "Nói"
                                        tip: nexa.state === "STANDBY" ? "Đánh thức NEXA (Ctrl+Alt+N)" : "Nhấn để nói"
                                        onClicked: nexa.state === "STANDBY" ? nexa.wake() : nexa.pushToTalk()
                                    }
                                    DockButton { glyphCode: 0xE708; caption: "Nghỉ"; tip: "Cho NEXA nghỉ"
                                                 showCaption: !stage.tight; size: stage.tight ? 36 : 42
                                                 enabled: nexa.state !== "STANDBY"; onClicked: nexa.sleep() }
                                    DockButton { glyphCode: 0xE815; caption: "Cử chỉ"; tint: win.purple; active: nexa.cameraOn
                                                 tip: nexa.cameraOn ? "Tắt cử chỉ tay (tắt camera)" : "Bật cử chỉ tay (bật camera)"
                                                 showCaption: !stage.tight; size: stage.tight ? 36 : 42
                                                 onClicked: nexa.toggleGestures() }
                                    DockButton { glyphCode: 0xF158; caption: "3D"; active: nexa3d.workspace || win.viewer3dOpen
                                                 tip: "Mô hình 3D"
                                                 showCaption: !stage.tight; size: stage.tight ? 36 : 42
                                                 onClicked: nexa3d.workspace = !nexa3d.workspace }
                                    DockButton { glyphCode: 0xE943; caption: "Code"; tint: win.blue; active: nexaCode.panelOpen
                                                 tip: "Sinh code"
                                                 showCaption: !stage.tight; size: stage.tight ? 36 : 42
                                                 onClicked: nexaCode.panelOpen ? nexaCode.closePanel() : nexaCode.openPanel() }
                                    DockButton { glyphCode: 0xE8BD; caption: "Hội thoại"; active: win.historyOpen
                                                 tip: "Lịch sử hội thoại và ô gõ lệnh (Ctrl+H)"
                                                 showCaption: !stage.tight; size: stage.tight ? 36 : 42
                                                 onClicked: win.toggleHistory() }
                                    DockButton { glyphCode: 0xE711; caption: "Hủy"; tint: "#fbbf24"; visible: win.busy
                                                 tip: "Hủy tác vụ đang chạy"
                                                 showCaption: !stage.tight; size: stage.tight ? 36 : 42
                                                 onClicked: nexa.cancelTask() }
                                    DockButton { id: moreBtn; glyphCode: 0xE712; caption: "Thêm"; tip: "Bảng cử chỉ, chuột bằng tay…"
                                                 showCaption: !stage.tight; size: stage.tight ? 36 : 42
                                                 onClicked: moreMenu.popup(moreBtn, 0, -moreMenu.implicitHeight - 6) }
                                }
                                Menu {
                                    id: moreMenu
                                    padding: 6
                                    background: Rectangle { implicitWidth: 240; radius: 10; color: "#0b1a33"; border.color: win.panelBorder }
                                    DarkMenuItem { text: gesturePanel.visible ? "Đóng bảng cử chỉ" : "Bảng cử chỉ…"
                                                   onTriggered: gesturePanel.visible = !gesturePanel.visible }
                                    DarkMenuItem { text: nexa.airMouse ? "Tắt chuột bằng tay" : "Chuột bằng tay"
                                                   enabled: nexa.cameraOn; onTriggered: nexa.toggleAirMouse() }
                                    DarkMenuItem { text: "Xóa hội thoại"; onTriggered: nexa.clearConversation() }
                                    DarkMenuItem { text: "Thu gọn thành quả cầu nổi"; onTriggered: win.enterCompact(true) }
                                }
                            }
                            // DỪNG KHẨN CẤP: luôn hiện, viền đỏ, tách khỏi dock
                            Item {
                                id: stopBtn
                                objectName: "stopButton"
                                implicitWidth: Math.max(stopDisc.width, stopCap.visible ? stopCap.implicitWidth : 0)
                                implicitHeight: stopDisc.height + (stopCap.visible ? stopCap.implicitHeight + 3 : 0)
                                Rectangle {
                                    id: stopDisc
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    width: stage.tight ? 44 : 50; height: width; radius: width / 2
                                    color: stopMouse.pressed ? "#9f1239" : stopMouse.containsMouse ? "#4c0519" : "#1c0812"
                                    border.color: "#fb7185"; border.width: 2
                                    scale: stopMouse.pressed ? 0.94 : 1
                                    Rectangle { anchors.centerIn: parent; width: parent.width * 0.32; height: width; radius: 3
                                                color: stopMouse.containsMouse ? "white" : "#fb7185" }
                                }
                                Text { id: stopCap; visible: !stage.tight; anchors.top: stopDisc.bottom; anchors.topMargin: 3
                                       anchors.horizontalCenter: parent.horizontalCenter
                                       text: "DỪNG"; color: "#fb7185"; font.pixelSize: 11; font.bold: true; font.letterSpacing: 1 }
                                MouseArea { id: stopMouse; anchors.fill: parent; hoverEnabled: true; onClicked: nexa.stop() }
                                NTip { visible: stopMouse.containsMouse; text: "DỪNG KHẨN CẤP (Ctrl+Alt+Esc)" }
                            }
                        }
                    }
                }

                // tay nắm ở mép phải khi ngăn kéo đóng: số tin + mở lịch sử
                Rectangle {
                    id: drawerHandle
                    visible: !win.historyOpen
                    anchors.right: parent.right; anchors.verticalCenter: parent.verticalCenter
                    width: 30; height: 96; radius: 10
                    color: handleMouse.containsMouse ? "#12243f" : "#0a1428"
                    border.color: Qt.rgba(win.stateAccent.r, win.stateAccent.g, win.stateAccent.b, 0.35)
                    Column {
                        anchors.centerIn: parent
                        spacing: 8
                        Text { anchors.horizontalCenter: parent.horizontalCenter; text: win.glyph(0xE76B); font.family: win.iconFont
                               font.pixelSize: 11; color: win.textDim }
                        Text { anchors.horizontalCenter: parent.horizontalCenter; text: win.glyph(0xE8BD); font.family: win.iconFont
                               font.pixelSize: 14; color: win.stateAccent }
                        Text { anchors.horizontalCenter: parent.horizontalCenter; visible: chat.count > 0
                               text: chat.count > 99 ? "99+" : chat.count; color: win.textDim; font.pixelSize: 10 }
                    }
                    MouseArea { id: handleMouse; anchors.fill: parent; hoverEnabled: true; onClicked: win.toggleHistory() }
                    NTip { visible: handleMouse.containsMouse; text: "Mở hội thoại (Ctrl+H)" }
                }

                // màn hẹp: ngăn kéo nằm đè lên sân khấu → phủ tối, bấm ra ngoài để đóng
                Rectangle {
                    anchors.fill: parent
                    z: 9
                    radius: 16
                    color: "#99040914"
                    opacity: win.historyOpen && !stage.drawerDocked ? 1 : 0
                    visible: opacity > 0
                    Behavior on opacity { NumberAnimation { duration: 250 } }
                    MouseArea { anchors.fill: parent; onClicked: win.historyOpen = false }
                }

                // Ngăn kéo hội thoại: tin nhắn + thẻ tác vụ + ô gõ lệnh
                Rectangle {
                    id: chatPanel
                    objectName: "historyDrawer"
                    z: 10
                    width: stage.drawerW
                    anchors.top: parent.top; anchors.bottom: parent.bottom
                    x: win.historyOpen ? stage.width - width : stage.width + 8
                    Behavior on x { NumberAnimation { duration: 320; easing.type: Easing.OutCubic } }
                    visible: x < stage.width
                    color: "#f00a1428"; radius: 16; border.color: win.panelBorder
                    ColumnLayout {
                        anchors.fill: parent; anchors.margins: 14; spacing: 10
                        RowLayout {
                            spacing: 10
                            Rectangle { implicitWidth: 32; implicitHeight: 32; radius: 16
                                        color: Qt.rgba(win.stateAccent.r, win.stateAccent.g, win.stateAccent.b, 0.14)
                                        Text { anchors.centerIn: parent; text: win.glyph(0xE8BD); font.family: win.iconFont
                                               font.pixelSize: 14; color: win.stateAccent } }
                            Column {
                                Layout.fillWidth: true
                                Text { text: "Hội thoại"; color: "white"; font.pixelSize: 16; font.bold: true }
                                Text { text: nexa.foreground.length > 3 ? "Cửa sổ đích: " + nexa.foreground : "Lệnh và kết quả trong phiên này"
                                       color: win.textDim; font.pixelSize: 11; elide: Text.ElideMiddle
                                       width: Math.min(implicitWidth, chatPanel.width - 150) }
                            }
                            HeaderButton { glyphCode: 0xE74D; tip: "Xóa hội thoại"; hoverTint: "#fb7185"
                                           onClicked: nexa.clearConversation() }
                            HeaderButton { glyphCode: 0xE76C; tip: "Đóng ngăn hội thoại (Ctrl+H)"; onClicked: win.historyOpen = false }
                        }
                        Rectangle { Layout.fillWidth: true; implicitHeight: 1; color: win.panelBorder; opacity: 0.7 }
                        Item {
                            Layout.fillWidth: true; Layout.fillHeight: true
                            ListView {
                                id: chat
                                objectName: "chat"
                                anchors.fill: parent
                                clip: true; spacing: 8
                                model: nexa.timeline
                                onCountChanged: Qt.callLater(function() { chat.positionViewAtEnd() })
                                delegate: Item {
                                    id: row
                                    required property var modelData
                                    readonly property bool isTask: modelData.kind === "task"
                                    readonly property bool isUser: modelData.role === "user"
                                    width: chat.width
                                    height: isTask ? taskCard.height : bubble.height
                                    Rectangle {
                                        id: bubble
                                        visible: !row.isTask
                                        anchors.right: row.isUser ? parent.right : undefined
                                        anchors.left: row.isUser ? undefined : parent.left
                                        width: Math.min(chat.width * 0.82, Math.max(msg.implicitWidth, meta.implicitWidth) + 28)
                                        height: msg.implicitHeight + meta.implicitHeight + 24
                                        radius: 14
                                        color: row.isUser ? "#13315f" : "#0f1d38"
                                        border.color: row.isUser ? "#2a5ba8" : "#233a62"
                                        Column {
                                            anchors.fill: parent; anchors.margins: 12; anchors.topMargin: 10; spacing: 4
                                            Row {
                                                id: meta
                                                spacing: 6
                                                Text { text: row.isUser ? "Anh Sơn" : "NEXA"; font.pixelSize: 11; font.bold: true
                                                       color: row.isUser ? "#93c5fd" : "#67e8f9" }
                                                Text { visible: row.isUser && row.modelData.source === "voice"; text: win.glyph(0xE720)
                                                       font.family: win.iconFont; font.pixelSize: 10; color: "#6f8fb0"
                                                       anchors.verticalCenter: parent.verticalCenter }
                                                Text { text: row.modelData.time || ""; font.pixelSize: 11; color: "#6f8fb0" }
                                            }
                                            Text { id: msg; width: Math.min(chat.width * 0.82 - 28, implicitWidth); text: row.isTask ? "" : (row.modelData.text || "")
                                                   color: "#f1f6ff"; font.pixelSize: 14; lineHeight: 1.12; wrapMode: Text.Wrap; textFormat: Text.PlainText }
                                        }
                                    }
                                    // Thẻ tác vụ: một bước = một thẻ, cập nhật tại chỗ (đang chạy → xong / lỗi)
                                    Rectangle {
                                        id: taskCard
                                        visible: row.isTask
                                        readonly property color sc: win.taskColor(row.modelData.status)
                                        readonly property bool spinning: row.isTask && (row.modelData.status === "running" || row.modelData.status === "queued")
                                        x: 12
                                        width: Math.min(chat.width - 28, tRow.implicitWidth + 30)
                                        height: 36
                                        radius: 9
                                        color: Qt.rgba(sc.r, sc.g, sc.b, 0.07)
                                        border.color: Qt.rgba(sc.r, sc.g, sc.b, 0.4)
                                        Rectangle { x: 6; width: 3; height: parent.height - 14; radius: 1.5; anchors.verticalCenter: parent.verticalCenter
                                                    color: taskCard.sc }
                                        Row {
                                            id: tRow
                                            x: 18; anchors.verticalCenter: parent.verticalCenter
                                            spacing: 8
                                            Item {
                                                width: 16; height: 16; anchors.verticalCenter: parent.verticalCenter
                                                Text { anchors.centerIn: parent; visible: taskCard.spinning; text: win.glyph(0xE9F5)
                                                       font.family: win.iconFont; font.pixelSize: 14; color: taskCard.sc
                                                       RotationAnimator on rotation { from: 0; to: 360; duration: 1600; loops: Animation.Infinite
                                                                                      running: taskCard.spinning } }
                                                Text { anchors.centerIn: parent; visible: !taskCard.spinning; text: win.glyph(win.taskGlyph(row.modelData.status))
                                                       font.family: win.iconFont; font.pixelSize: 13; font.bold: true; color: taskCard.sc }
                                            }
                                            Text { id: tTitle; text: row.isTask ? (row.modelData.title || "") : ""; color: "white"; font.pixelSize: 13; font.bold: true
                                                   anchors.verticalCenter: parent.verticalCenter }
                                            Text { text: row.isTask ? (row.modelData.text || "") : ""; color: win.textDim; font.pixelSize: 12; elide: Text.ElideRight
                                                   visible: text.length > 0 && text !== tTitle.text
                                                   width: Math.min(implicitWidth, Math.max(40, chat.width - 28 - 30 - 18 - 16 - tTitle.implicitWidth - tTime.implicitWidth - 32))
                                                   anchors.verticalCenter: parent.verticalCenter }
                                            Text { id: tTime; text: row.modelData.time || ""; color: "#56759a"; font.pixelSize: 11
                                                   anchors.verticalCenter: parent.verticalCenter }
                                        }
                                    }
                                }
                            }
                            Column {
                                anchors.centerIn: parent
                                visible: chat.count === 0
                                spacing: 6
                                Text { anchors.horizontalCenter: parent.horizontalCenter; text: win.glyph(0xE8F2); font.family: win.iconFont
                                       font.pixelSize: 34; color: "#1e3a5f" }
                                Text { anchors.horizontalCenter: parent.horizontalCenter; text: "Vỗ tay, nói “Nexa ơi” hoặc gõ lệnh bên dưới"
                                       color: win.textDim; font.pixelSize: 13 }
                                Text { anchors.horizontalCenter: parent.horizontalCenter; text: "Kết quả từng lệnh sẽ hiện ngay trong hội thoại."
                                       color: "#4b6a8a"; font.pixelSize: 12 }
                            }
                        }
                        Rectangle {
                            Layout.fillWidth: true
                            implicitHeight: 46; radius: 23
                            color: "#081226"
                            border.color: input.activeFocus ? win.stateAccent : win.panelBorder
                            RowLayout {
                                anchors.fill: parent; anchors.leftMargin: 16; anchors.rightMargin: 5; spacing: 6
                                TextField {
                                    id: input
                                    Layout.fillWidth: true
                                    placeholderText: "Nhập lệnh cho NEXA… (ví dụ: mở Notepad, đặt âm lượng 30 phần trăm)"
                                    color: "white"; font.pixelSize: 14
                                    placeholderTextColor: "#5b7a99"
                                    leftPadding: 0
                                    background: Item {}
                                    onAccepted: { if (text.trim().length) { nexa.sendText(text); text = "" } }
                                }
                                Rectangle {
                                    id: sendBtn
                                    readonly property bool ready: input.text.trim().length > 0
                                    implicitWidth: 36; implicitHeight: 36; radius: 18
                                    color: ready ? (sendMouse.pressed ? Qt.darker(win.stateAccent, 1.4) : win.stateAccent) : "#12243f"
                                    Text { anchors.centerIn: parent; text: win.glyph(0xE724); font.family: win.iconFont; font.pixelSize: 15
                                           color: sendBtn.ready ? "#041020" : "#5b7a99" }
                                    MouseArea { id: sendMouse; anchors.fill: parent; hoverEnabled: true
                                                onClicked: { if (input.text.trim().length) { nexa.sendText(input.text); input.text = "" } } }
                                    NTip { visible: sendMouse.containsMouse; text: "Gửi (Enter)" }
                                }
                            }
                        }
                        Text { Layout.fillWidth: true; visible: text.length > 0; text: nexa.statusText
                               color: "#5f7fa0"; font.pixelSize: 11; elide: Text.ElideRight }
                    }
                }
            }

            // Mô hình 3D (tệp riêng; Loader để lỗi plugin Qt Quick 3D không ảnh hưởng giao diện chính)
            Loader {
                id: viewer3d
                objectName: "viewer3d"
                active: win.viewerShown
                visible: active
                focus: active
                Layout.fillHeight: true
                Layout.preferredWidth: Math.max(560, Math.min(win.width * 0.6, win.width - 520))
                source: "ModelViewer.qml"
                onStatusChanged: if (status === Loader.Error) toastBox.show("Không nạp được trình xem 3D (thiếu Qt Quick 3D?). Xem logs/nexa.log.", true)
            }

            // Sinh code (cột phải, giống trình xem 3D): NEXA vẫn hiện đầy đủ bên trái
            Loader {
                id: codePanel
                objectName: "codePanel"
                active: win.codeShown
                visible: active
                Layout.fillHeight: true
                Layout.preferredWidth: Math.max(560, win.width - 28 - 14 - win.sideNexaWidth)
                sourceComponent: Component { CodePanel { onCloseRequested: nexaCode.closePanel() } }
            }
        }
    }

    // ---------- Bảng cử chỉ ----------
    GesturePanel {
        id: gesturePanel
        visible: false
        anchors.right: parent.right; anchors.top: parent.top; anchors.bottom: parent.bottom
        anchors.margins: 14; anchors.topMargin: 64; anchors.bottomMargin: 14
        width: 380
        z: 5
        onCloseRequested: visible = false
    }

    // ---------- Mô hình 3D (tệp riêng; Loader để lỗi plugin Qt Quick 3D không ảnh hưởng giao diện chính) ----------
    Loader {
        id: generation3d
        active: nexa3d.workspace && !nexa3d.viewerOpen && !nexa.compact
        anchors.centerIn: parent
        width: Math.min(win.width - 80, 980); height: Math.min(win.height - 90, 680)
        z: 18
        sourceComponent: Component { ModelGenerationPanel { onCloseRequested: nexa3d.workspace = false } }
    }
    // (trình xem 3D nằm trong "Nội dung chính", cạnh cột NEXA)

    // (Sinh code nằm trong "Nội dung chính", cạnh cột NEXA)

    // ---------- Hộp xác nhận ----------
    Popup {
        id: confirmPopup
        modal: true
        closePolicy: Popup.NoAutoClose
        visible: nexa.confirmation.active === true
        anchors.centerIn: parent
        width: Math.min(win.width - 80, nexa.confirmation.previewUrl ? 900 : 560)
        padding: 20
        property int remaining: nexa.confirmation.timeout || 30
        onVisibleChanged: { if (visible) { remaining = nexa.confirmation.timeout || 30; cropRect.reset() } }
        Timer { interval: 1000; repeat: true; running: confirmPopup.visible; onTriggered: confirmPopup.remaining = Math.max(0, confirmPopup.remaining - 1) }
        background: Rectangle { radius: 16; color: "#0b1220"; border.color: "#f59e0b"; border.width: 2 }
        contentItem: ColumnLayout {
            spacing: 12
            Text { text: "Cần anh xác nhận"; color: "#fbbf24"; font.pixelSize: 20; font.bold: true }
            Text { Layout.fillWidth: true; text: nexa.confirmation.description || ""; color: "white"; font.pixelSize: 15; wrapMode: Text.Wrap }
            Item {
                id: previewBox
                visible: !!nexa.confirmation.previewUrl
                Layout.fillWidth: true
                Layout.preferredHeight: visible ? Math.min(420, width * (nexa.confirmation.preview_height || 1) / Math.max(1, nexa.confirmation.preview_width || 1)) : 0
                Image {
                    id: shot
                    anchors.fill: parent
                    source: nexa.confirmation.previewUrl || ""
                    fillMode: Image.PreserveAspectFit
                    cache: false
                }
                // Kéo chuột để chọn vùng gửi đi (tọa độ quy đổi về pixel ảnh gốc).
                Rectangle {
                    id: cropRect
                    property bool has: false
                    function reset() { has = false; x = 0; y = 0; width = 0; height = 0 }
                    visible: has
                    color: "#2222d3ee"; border.color: win.cyan; border.width: 2
                }
                MouseArea {
                    anchors.fill: parent
                    property point p0
                    onPressed: (m) => { p0 = Qt.point(m.x, m.y); cropRect.has = true; cropRect.x = m.x; cropRect.y = m.y; cropRect.width = 0; cropRect.height = 0 }
                    onPositionChanged: (m) => { cropRect.x = Math.min(p0.x, m.x); cropRect.y = Math.min(p0.y, m.y)
                                                cropRect.width = Math.abs(m.x - p0.x); cropRect.height = Math.abs(m.y - p0.y) }
                }
                Text { anchors.bottom: parent.bottom; anchors.left: parent.left; color: win.textDim; font.pixelSize: 11
                       text: "Kéo chuột trên ảnh để chỉ gửi một vùng. Không chọn = gửi toàn bộ ảnh trên." }
            }
            RowLayout {
                spacing: 10
                Text { text: "Tự hủy sau " + confirmPopup.remaining + " giây"; color: win.textDim; font.pixelSize: 12 }
                Item { Layout.fillWidth: true }
                NButton { text: "Hủy"; onClicked: nexa.deny(nexa.confirmation.id) }
                NButton {
                    text: "Đồng ý"; tint: "#34d399"
                    onClicked: {
                        var cx = 0, cy = 0, cw = 0, ch = 0
                        if (cropRect.has && cropRect.width > 8 && cropRect.height > 8 && shot.paintedWidth > 0) {
                            var ox = (shot.width - shot.paintedWidth) / 2, oy = (shot.height - shot.paintedHeight) / 2
                            var sx = shot.sourceSize.width / shot.paintedWidth, sy = shot.sourceSize.height / shot.paintedHeight
                            cx = Math.max(0, (cropRect.x - ox) * sx); cy = Math.max(0, (cropRect.y - oy) * sy)
                            cw = cropRect.width * sx; ch = cropRect.height * sy
                        }
                        nexa.confirm(nexa.confirmation.id, cx, cy, cw, ch)
                    }
                }
            }
        }
    }

    // ---------- Cài đặt ----------
    Popup {
        id: settingsPopup
        modal: true
        anchors.centerIn: parent
        width: Math.min(win.width - 60, 1040); height: Math.min(win.height - 60, 720)
        padding: 0
        background: Rectangle { radius: 16; color: "#081226"; border.color: win.panelBorder }
        contentItem: Loader {
            active: settingsPopup.visible
            sourceComponent: Component { Settings { onCloseRequested: settingsPopup.close() } }
        }
    }

    // ---------- Thông báo nổi ----------
    Rectangle {
        id: toastBox
        property bool isError: false
        function show(text, err) { toastText.text = text; isError = err; opacity = 1; toastTimer.restart() }
        anchors.horizontalCenter: parent.horizontalCenter
        y: parent.height - 120
        width: Math.min(parent.width - 80, toastText.implicitWidth + 40); height: toastText.implicitHeight + 20
        radius: 12; color: "#e6050b18"; border.color: isError ? "#fb7185" : win.cyan
        opacity: 0; visible: opacity > 0; z: 50
        Behavior on opacity { NumberAnimation { duration: 250 } }
        Text { id: toastText; anchors.centerIn: parent; width: Math.min(implicitWidth, win.width - 120); color: "white"
               font.pixelSize: 14; wrapMode: Text.Wrap }
        Timer { id: toastTimer; interval: 3500; onTriggered: toastBox.opacity = 0 }
    }
}
