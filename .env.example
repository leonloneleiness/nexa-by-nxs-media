# Sao chép tệp này thành .env (cùng thư mục) rồi điền key MỚI của anh trên máy.
# KHÔNG commit, không gửi tệp .env cho ai. Có thể đặt các biến này làm biến môi trường thay cho .env.
NEXA_AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_NEW_GEMINI_API_KEY
# Model đã đối chiếu với https://ai.google.dev/gemini-api/docs/models (09/2026): ổn định, hỗ trợ
# function calling + ảnh, độ trễ/chi phí thấp. Có thể đổi, ví dụ gemini-3.8-flash, nếu key có quyền.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=30
NEXA_MAX_TOOL_STEPS=8
NEXA_CLOUD_SCREEN_VISION=false
# Mô hình 3D bằng dịch vụ cloud (tùy chọn — CAD tham số cục bộ chạy không cần key). Xem docs/three_d.md.
NEXA_3D_PROVIDER=auto
# Mức 3 miễn phí qua Hugging Face Space: token đọc miễn phí (huggingface.co/settings/tokens) tăng hạn mức GPU.
HF_TOKEN=YOUR_HF_TOKEN
TRIPO_API_KEY=YOUR_TRIPO_API_KEY
MESHY_API_KEY=YOUR_MESHY_API_KEY
