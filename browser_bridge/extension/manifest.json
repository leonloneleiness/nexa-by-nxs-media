{
  "manifest_version": 3,
  "name": "NEXA Bridge",
  "version": "1.0.0",
  "description": "Cho phép ứng dụng NEXA trên máy này tạm dừng/phát tiếp đúng tab YouTube do anh gắn.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "NEXA Bridge",
    "default_popup": "popup.html"
  }
}
